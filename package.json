{
  "name": "meteoracle",
  "version": "0.2.0",
  "description": "Minimal Meteora DLMM LP bot — evil-panda on fresh shitcoins + simple Moonboy (max 3, 10$, 2x)",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.worker.json",
    "worker": "tsx --tsconfig tsconfig.worker.json worker.ts",
    "worker:build": "tsc --project tsconfig.worker.json",
    "worker:start": "node -r tsconfig-paths/register dist/worker.js",
    "start:worker": "node -r tsconfig-paths/register dist/worker.js",
    "start:telegram": "node -r tsconfig-paths/register dist/bot/telegram-bot.js",
    "type-check": "tsc --noEmit",
    "postinstall": "node scripts/patch-dlmm-esm.js"
  },
  "overrides": {
    "@meteora-ag/dlmm": {
      "exports": {
        ".": {
          "require": "./dist/index.cjs",
          "import": "./dist/index.cjs",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "dependencies": {
    "@meteora-ag/dlmm": "^1.9.10",
    "@meteora-ag/zap-sdk": "^1.3.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "axios": "^1.7.9",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "dotenv": "^17.3.1",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^20",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
