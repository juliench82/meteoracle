# =============================================================================
# METEORACLE — .env.local.example
#
# Copy this file to .env.local and fill in your values.
# Only override what you need — everything has sensible defaults in code.
#
# ORGANIZATION:
#   1. Required (must be set)
#   2. Safety Switches (strongly recommended)
#   3. Everything Else (strongly prefer using the website /config page)
#
# The goal is to keep this file as small as possible.
# Use the dashboard Config page for most tweaks instead of editing .env.local.
#
# NOTE: DAMM v2 / DAMM Edge support has been fully removed from the bot.
#       Only DLMM strategies (evil-panda, scalp-spike, etc.) are active.
# =============================================================================


# =============================================================================
# 1. REQUIRED — Core Infrastructure
# =============================================================================

SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

HELIUS_API_KEY=

WALLET_PRIVATE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# =============================================================================
# 2. SAFETY SWITCHES (Strongly recommended to review)
# =============================================================================

# Master switch for the whole bot
BOT_ENABLED=false

# Extremely important safety net — keeps the bot from opening real positions
BOT_DRY_RUN=true


# =============================================================================
# 3. CORE RISK & SIZING (Strongly recommended to set explicitly)
# =============================================================================
# These have a direct impact on how much money is at risk.
# Wrong values here can be expensive, so they are left active by default.

MAX_CONCURRENT_MARKET_LP_POSITIONS=5
MAX_MARKET_LP_SOL_PER_POSITION=0.1
MAX_MARKET_LP_SOL_DEPLOYED=1.0
WALLET_MIN_SOL_RESERVE=0.5

# MAX_DAILY_LOSS_SOL=0.5


# =============================================================================
# 4. OPTIONAL TUNING (Everything below has reasonable defaults)
# =============================================================================
# These are useful for fine-tuning but are **not strictly required**.
# Most have sensible defaults in the code and can also be changed live
# via the website /config page.
#
# Only uncomment what you actually want to override.

# --- Scanner Behavior ---
# LP_SCAN_INTERVAL_SEC=300
# MAX_DEEP_CHECKS=6
# DEEP_CHECK_DELAY_MS=1500
# FRESH_SNIPE_MAX_AGE_MINUTES=30
# SCANNER_EARLY_MAX_AGE_MINUTES=90
# HARD_MAX_TOKEN_AGE_MINUTES=120
# MATURE_MIN_SCORE_TO_OPEN=80
# CANDIDATE_DEDUP_HOURS=1
# MIN_SCORE_TO_OPEN=65

# Meteora pool fetching
# METEORA_MIN_TVL_USD=8000
# METEORA_MIN_FEE_TVL_RATIO_1H=0.001
# METEORA_MIN_VOLUME_TVL_1H_RATIO=0.20
# METEORA_POOL_FETCH_LIMIT=800

# --- Feature Flags ---
# EVIL_PANDA_ENABLED=true
# SCALP_SPIKE_ENABLED=true
# STABLE_FARM_ENABLED=true
# BLUECHIP_FARM_ENABLED=false
# MOONBOY_ENABLED=true
# HELIUS_ENABLED=true
# LP_SCANNER_ENABLED=true

# --- Evil Panda Strategy ---
# EVIL_PANDA_MAX_AGE_HOURS=48
# EVIL_PANDA_MIN_RUGCHECK_SCORE=40
# EVIL_PANDA_MIN_HOLDER_COUNT=50
# EVIL_PANDA_MIN_LIQUIDITY_USD=5000

# --- Scalp Spike Strategy ---
# SCALP_SPIKE_MIN_MC_USD=500000
# SCALP_SPIKE_MIN_RUGCHECK_SCORE=50
# SCALP_SPIKE_MIN_HOLDER_COUNT=150
# SCALP_SPIKE_MIN_LIQUIDITY_USD=10000

# --- Monitor & Operations ---
# LP_MONITOR_INTERVAL_SEC=60
# MONITOR_EXITS_ENABLED=true
# MONITOR_SYNC_FAIL_ALERT_THRESHOLD=3
# ORPHAN_CHECK_EVERY_N=1

# --- Advanced / Rarely Needed ---
# SCANNER_PERSIST_POOL_CACHE=false   # Strongly recommended to keep as false (heavy on Supabase Disk IO)
# SCANNER_POOL_CACHE_RETENTION_HOURS=48
# SWAP_SLIPPAGE_BPS=100
# SOL_PRICE_USD=          # Only set if you want to override live price

# etc.

# Avoid putting dozens of variables here — it becomes hard to review.
# Use the website config UI when possible for most tuning.
