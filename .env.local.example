# =============================================================================
# METEORACLE — .env.local
# Only variables that MUST be set explicitly are listed here.
# Everything else has a safe default in the source code.
# =============================================================================

# --- Supabase (REQUIRED) -----------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# --- Solana RPC (REQUIRED) ---------------------------------------------------
HELIUS_API_KEY=YOUR_KEY

# --- Wallet (REQUIRED) -------------------------------------------------------
# Base58 private key. NEVER commit the real value.
WALLET_PRIVATE_KEY=
WALLET_PUBLIC_KEY=

# --- Telegram (REQUIRED) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=

# --- Bot kill-switches -------------------------------------------------------
# Set BOT_DRY_RUN=false only when ready to trade real funds.
BOT_ENABLED=false
BOT_DRY_RUN=true

# --- Position sizing & risk --------------------------------------------------
MAX_CONCURRENT_MARKET_LP_POSITIONS=3
MAX_MARKET_LP_SOL_PER_POSITION=0.1
MAX_MARKET_LP_SOL_DEPLOYED=0.99
WALLET_MIN_SOL_RESERVE=0.5
MAX_DAILY_LOSS_SOL=0

# --- Strategy on/off switches ------------------------------------------------
EVIL_PANDA_ENABLED=true
SCALP_SPIKE_ENABLED=true
DAMM_EDGE_ENABLED=false

# --- Monitor & exits (added for alignment) -----------------------------------
LP_MONITOR_INTERVAL_SEC=60
LP_SMART_REBALANCE_IN_RANGE=false
MONITOR_EXITS_ENABLED=true
LP_MONITOR_ENABLED=true
MONITOR_SYNC_FAIL_ALERT_THRESHOLD=3
ORPHAN_CHECK_EVERY_N=1
MONITOR_LIVE_CACHE_EXIT_STRATEGY_ID=
MONITOR_LIVE_CACHE_ALERT_INTERVAL_MIN=15
LP_MONITOR_STANDALONE=false

# --- DAMM v2 (added for alignment) -------------------------------------------
MAX_CONCURRENT_DAMM_MIGRATION_POSITIONS=1
DAMM_MIGRATION_SOL_PER_POSITION=0.1
MAX_DAMM_MIGRATION_SOL_DEPLOYED=0.1
DAMM_POOL_RESOLVE_TIMEOUT_MS=6000
DAMM_POOL_RESOLVE_PAGE_SIZE=20
DAMM_POOL_RESOLVE_CANDIDATE_LIMIT=8

# --- Swap (added for alignment) ----------------------------------------------
SWAP_SLIPPAGE_BPS=100
