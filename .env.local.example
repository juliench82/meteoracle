# =============================================================================
# METEORACLE — .env.local.example
#
# Copy this file to .env.local and fill in your values.
# Only override what you need — everything has sensible defaults in code.
#
# ORGANIZATION:
#   1. Required (must be set)
#   2. Core Risk & Sizing (very important to review)
#   3. Scanner Tuning (how the bot finds opportunities)
#   4. Strategy Settings (per-strategy filters & behavior)
#   5. Monitor & Operations
#   6. Advanced / Rarely Changed
#
# Most people only need to touch sections 1, 2, and parts of 4.
# =============================================================================


# =============================================================================
# 1. REQUIRED — Core Infrastructure
# =============================================================================

SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

HELIUS_API_KEY=

WALLET_PRIVATE_KEY=
WALLET_PUBLIC_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=


# =============================================================================
# 2. CORE RISK & SIZING (Review these carefully)
# =============================================================================

# --- Bot Safety ---
BOT_ENABLED=false
BOT_DRY_RUN=true                    # Set to false only when ready for real money

# --- Position Sizing & Exposure ---
MAX_CONCURRENT_MARKET_LP_POSITIONS=5
MAX_MARKET_LP_SOL_PER_POSITION=0.1
MAX_MARKET_LP_SOL_DEPLOYED=1.0
WALLET_MIN_SOL_RESERVE=0.5
MAX_DAILY_LOSS_SOL=0


# =============================================================================
# 3. SCANNER TUNING
# =============================================================================

# How often the scanner runs (in seconds)
# 180 = 3 min — safe for free-tier Rugcheck/DexScreener rate limits while giving
# ~5 ticks per 15 min vs the original 1 tick. Raise to 900 if you hit rate limits.
LP_SCANNER_POLL_INTERVAL_SEC=180

# Deep check behavior
# DEEP_CHECK_DELAY_MS=2000 — 2s sleep between tokens protects free-tier API quotas.
# MAX_DEEP_CHECKS=12 — 12 per tick × ~5 ticks/15min = ~60 deep checks vs original 12.
# Split evenly across fresh/momentum lanes. Raise only if you have paid API plans.
DEEP_CHECK_DELAY_MS=2000
MAX_DEEP_CHECKS=12

# Lane configuration
FRESH_SCANNER_MAX_AGE_MINUTES=90
FRESH_MIN_LIQUIDITY_USD=20000
MOMENTUM_MIN_VOLUME_5M_USD=5000
MOMENTUM_MIN_FEE_TVL_5M_PCT=0.1

# Volume spike detection (used by Scalp Spike lane)
SCALP_SPIKE_VOL_RATIO=2.5
SCALP_SPIKE_MIN_FEE_TVL_5M_PCT=0.1
SCALP_SPIKE_MIN_FEE_TVL_1H_PCT=1

# Deduplication (set to 6 or higher if you want to reduce spam in candidates)
CANDIDATE_DEDUP_HOURS=0


# =============================================================================
# 4. STRATEGY SETTINGS
# =============================================================================

# --- Evil Panda (Main meme shitcoin strategy) ---
EVIL_PANDA_ENABLED=true

# Entry filters (most important ones after the Option A review)
EVIL_PANDA_MAX_AGE_HOURS=3                    # Was 2h — now allows slightly more mature tokens
EVIL_PANDA_MIN_RUGCHECK_SCORE=50              # Max possible Meteoracle rug score = 100. 50 is a reasonable floor.
EVIL_PANDA_MIN_LIQUIDITY_USD=5000
EVIL_PANDA_MIN_HOLDER_COUNT=50                # Lowered because Helius holder data is often capped/unreliable on free plan
EVIL_PANDA_MIN_HOLDER_COUNT_UNDER_60M=50      # Special lower threshold for very fresh tokens
# Note: When Helius holder data is unreliable (reliable=false), holder score contribution is disabled (set to 0).
EVIL_PANDA_MAX_TOP_HOLDER_PCT=30
EVIL_PANDA_MIN_BIN_STEP=80

# Position sizing & range
EVIL_PANDA_BIN_STEP=100
EVIL_PANDA_RANGE_DOWN_PCT=-50
EVIL_PANDA_RANGE_UP_PCT=100
EVIL_PANDA_SOL_BIAS=1

# Exit rules
EVIL_PANDA_STOP_LOSS_PCT=-25
EVIL_PANDA_TAKE_PROFIT_PCT=50
EVIL_PANDA_OOR_MINUTES=30
EVIL_PANDA_MAX_DURATION_HOURS=12
EVIL_PANDA_MIN_FEES_TO_CLAIM=0.001
EVIL_PANDA_MAX_IL_PCT=-15


# --- Scalp Spike (High-conviction volume surges) ---
SCALP_SPIKE_ENABLED=true

SCALP_SPIKE_MIN_MC_USD=500000
SCALP_SPIKE_MIN_LIQUIDITY_USD=10000
SCALP_SPIKE_MIN_HOLDER_COUNT=150              # Lowered because Helius holder data is often capped/unreliable on free plan
SCALP_SPIKE_MAX_TOP_HOLDER_PCT=25
SCALP_SPIKE_MIN_RUGCHECK_SCORE=60             # Max possible Meteoracle rug score = 100
# Note: When Helius holder data is unreliable (reliable=false), holder score contribution is disabled (set to 0).

SCALP_SPIKE_BIN_STEP=100
SCALP_SPIKE_RANGE_DOWN_PCT=-20
SCALP_SPIKE_RANGE_UP_PCT=40
SCALP_SPIKE_STOP_LOSS_PCT=-15
SCALP_SPIKE_TAKE_PROFIT_PCT=30
SCALP_SPIKE_OOR_MINUTES=15
SCALP_SPIKE_MAX_DURATION_HOURS=6


# --- DAMM Edge (Very fresh DAMM v2 pre-grad tokens) ---
DAMM_EDGE_ENABLED=false

# Loosened in May 2026 (Option A)
DAMM_EDGE_MAX_AGE_MINUTES=25
DAMM_EDGE_MIN_FEE_TVL_PCT=5
DAMM_EDGE_MIN_LIQUIDITY_USD=25000
DAMM_EDGE_MAX_MC_USD=5000000
DAMM_EDGE_SOL_PER_POSITION=0.1


# --- DAMM Migration / Pre-grad Track (separate from pure DAMM Edge) ---
MAX_CONCURRENT_DAMM_MIGRATION_POSITIONS=1
DAMM_MIGRATION_SOL_PER_POSITION=0.1
MAX_DAMM_MIGRATION_SOL_DEPLOYED=0.1


# --- Stable Farm ---
STABLE_FARM_ENABLED=true

STABLE_FARM_MIN_LIQUIDITY_USD=50000
STABLE_FARM_BIN_STEP=1
STABLE_FARM_RANGE_DOWN_PCT=-2
STABLE_FARM_RANGE_UP_PCT=2
STABLE_FARM_STOP_LOSS_PCT=-5
STABLE_FARM_TAKE_PROFIT_PCT=10
STABLE_FARM_OOR_MINUTES=10
STABLE_FARM_MAX_DURATION_HOURS=168
STABLE_FARM_MIN_FEES_TO_CLAIM=0.0001
STABLE_FARM_MAX_IL_PCT=-3


# --- Bluechip Farm (Disabled by default) ---
BLUECHIP_FARM_ENABLED=false

BLUECHIP_FARM_MIN_MC_USD=100000000
BLUECHIP_FARM_MIN_VOLUME_24H=500000
BLUECHIP_FARM_MIN_LIQUIDITY_USD=100000
BLUECHIP_FARM_MIN_HOLDER_COUNT=5000
BLUECHIP_FARM_MAX_TOP_HOLDER_PCT=25


# --- Moonboy (Aggressive early entries) ---
MOONBOY_ENABLED=true


# =============================================================================
# 5. MONITOR & OPERATIONS
# =============================================================================

LP_MONITOR_INTERVAL_SEC=60
LP_MONITOR_ENABLED=true
MONITOR_EXITS_ENABLED=true
MONITOR_SYNC_FAIL_ALERT_THRESHOLD=3
ORPHAN_CHECK_EVERY_N=1


# =============================================================================
# 6. ADVANCED / TRANSACTION SETTINGS
# =============================================================================

SWAP_SLIPPAGE_BPS=100

# Optional but recommended on mainnet
# PRIORITY_FEE_MICROLAMPORTS=100000
# COMPUTE_UNIT_LIMIT=400000

# Enable this only for debugging
# LP_SCANNER_ENABLED=true
