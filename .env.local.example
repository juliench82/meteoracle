# =============================================================================
# METEORACLE — .env.local.example (Minimal Version)
#
# Copy this file to .env.local and fill in your values.
#
# Ultra-simplified model:
# - Evil Panda LP on very fresh tokens + Moonboy companion spot buys (max 3)
# - Local JSON state (state/ folder) is the source of truth
# - Supabase used only for alerts + lightweight bot_logs (not in hot paths)
#
# No dashboard. No heavy modules.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=                  # Used for alerts + bot_logs (can be lightweight)
SUPABASE_SECRET_KEY=

HELIUS_API_KEY=                # Strongly recommended for accurate holder data

WALLET_PRIVATE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ─────────────────────────────────────────────────────────────────────────────
# SAFETY (very important)
# ─────────────────────────────────────────────────────────────────────────────
BOT_ENABLED=false
BOT_DRY_RUN=true


# ─────────────────────────────────────────────────────────────────────────────
# RISK & POSITION SIZING
# ─────────────────────────────────────────────────────────────────────────────
MAX_CONCURRENT_MARKET_LP_POSITIONS=3
MAX_MARKET_LP_SOL_PER_POSITION=0.1
MAX_MARKET_LP_SOL_DEPLOYED=0.5
WALLET_MIN_SOL_RESERVE=0.4    # Code default is 0.1 — raise for safety on small wallets

# Optional daily loss circuit breaker
# MAX_DAILY_LOSS_SOL=0.3


# ─────────────────────────────────────────────────────────────────────────────
# MOONBOY (companion spot buys)
# ─────────────────────────────────────────────────────────────────────────────
MOONBOY_ENABLED=true
MOONBOY_BUY_USD=10                 # Hard cap per buy
# MOONBOY_MAX_OPEN=3               # Already enforced in code (max 3 concurrent)


# ─────────────────────────────────────────────────────────────────────────────
# EVIL PANDA LP STRATEGY (main LP logic)
# ─────────────────────────────────────────────────────────────────────────────
# Freshness & quality gates
# EVIL_PANDA_MAX_AGE_HOURS=1.5         # Recommended for aggressive fresh hunting
# EVIL_PANDA_MIN_RUGCHECK_SCORE=40
# EVIL_PANDA_MIN_LIQUIDITY_USD=8000
# EVIL_PANDA_MAX_TOP_HOLDER_PCT=30

# Bin range (wide for stability on volatile names)
# EVIL_PANDA_RANGE_DOWN_PCT=-50
# EVIL_PANDA_RANGE_UP_PCT=100
# EVIL_PANDA_BIN_STEP=100

# Exit rules (snapshotted per position at open time)
# EVIL_PANDA_STOP_LOSS_PCT=-25
# EVIL_PANDA_TAKE_PROFIT_PCT=50
# EVIL_PANDA_OOR_MINUTES=30
# EVIL_PANDA_MAX_DURATION_HOURS=12
# EVIL_PANDA_MIN_FEES_TO_CLAIM=0.001
# EVIL_PANDA_MAX_IL_PCT=-15


# ─────────────────────────────────────────────────────────────────────────────
# SCANNER & MONITOR TIMING
# ─────────────────────────────────────────────────────────────────────────────
LP_SCAN_INTERVAL_SEC=900           # 15 minutes (code default). Use 300 for more aggressive scanning
LP_MONITOR_INTERVAL_SEC=60

# SCANNER_PERSIST_POOL_CACHE is no longer used (fully removed in simplified model)


# ─────────────────────────────────────────────────────────────────────────────
# LP EXIT RULES (ultra-minimal 4-rule model — 48h dry-run starting point)
# Primary goal: fee-farm efficiency. Reassess after 48h of real dry-run data.
# ─────────────────────────────────────────────────────────────────────────────
# LP_FEE_TVL_EXIT_THRESHOLD=0.75     # last-4h avg of pool 24h Fee/TVL % below this → close
# LP_OOR_EXIT_MINUTES=45             # minutes continuously out of range before exit
# LP_NET_LOSS_SL_PCT=-30             # net PnL (price move + claimed + unclaimed fees) stop loss
# LP_NET_LOSS_SL_MIN_AGE_MIN=20      # grace period (minutes) before net-PnL SL can trigger
# LP_MAX_DURATION_HOURS=24           # hard safety cap on any position
# LP_MONITOR_ENABLED=true



# ─────────────────────────────────────────────────────────────────────────────
# SLIPPAGE & EXECUTION
# ─────────────────────────────────────────────────────────────────────────────
SWAP_SLIPPAGE_BPS=200              # Starting point for Jupiter ladders (open + close)


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL / ADVANCED
# ─────────────────────────────────────────────────────────────────────────────
# SOL_PRICE_USD=150                # Only set to override live Jupiter price

# Scanner decision tuning
# MIN_SCORE_TO_OPEN=65             # Evil Panda score threshold to actually open
# FRESH_MAX_AGE_MINUTES=120        # Scanner lane freshness gate (higher = more candidates)
# FRESH_MIN_LIQUIDITY_USD=8000

# Meteora pool fetch filters (advanced)
# METEORA_MIN_TVL_USD=8000
# METEORA_MIN_FEE_TVL_RATIO_1H=0.001
# METEORA_MIN_VOLUME_TVL_1H_RATIO=0.20
# METEORA_POOL_FETCH_LIMIT=800
