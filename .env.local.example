# =============================================================================
# METEORACLE — .env.local.example (Minimal Version)
#
# Copy this file to .env.local and fill in your values.
#
# This version is aligned with the simplified architecture:
# - Only evil-panda strategy for LP on very fresh shitcoins
# - Moonboy companion buys on fresh detections (max 3 concurrent)
# - State lives primarily in local JSON files (state/ folder)
# - Supabase used only for lightweight logging (bot_logs)
#
# No dashboard. Minimal DB surface.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SECRET_KEY=

HELIUS_API_KEY=                # Recommended for better holder data

WALLET_PRIVATE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ─────────────────────────────────────────────────────────────────────────────
# SAFETY (very important)
# ─────────────────────────────────────────────────────────────────────────────
BOT_ENABLED=false
BOT_DRY_RUN=true


# ─────────────────────────────────────────────────────────────────────────────
# RISK & POSITION SIZING
# ─────────────────────────────────────────────────────────────────────────────
MAX_CONCURRENT_MARKET_LP_POSITIONS=3
MAX_MARKET_LP_SOL_PER_POSITION=0.1
MAX_MARKET_LP_SOL_DEPLOYED=0.5
WALLET_MIN_SOL_RESERVE=0.4

# Optional daily loss circuit breaker
# MAX_DAILY_LOSS_SOL=0.3


# ─────────────────────────────────────────────────────────────────────────────
# MOONBOY (companion spot buys)
# ─────────────────────────────────────────────────────────────────────────────
MOONBOY_ENABLED=true
MOONBOY_BUY_USD=10                 # Hard cap per buy
# MOONBOY_MAX_OPEN=3               # Already enforced in code (max 3 concurrent)


# ─────────────────────────────────────────────────────────────────────────────
# EVIL PANDA LP STRATEGY (main LP logic)
# ─────────────────────────────────────────────────────────────────────────────
# EVIL_PANDA_MAX_AGE_HOURS=1.5     # Recommended: max ~90 minutes for fresh entries
# EVIL_PANDA_MIN_RUGCHECK_SCORE=40
# EVIL_PANDA_MIN_LIQUIDITY_USD=8000


# ─────────────────────────────────────────────────────────────────────────────
# SCANNER & MONITOR TIMING
# ─────────────────────────────────────────────────────────────────────────────
LP_SCAN_INTERVAL_SEC=300           # 5 minutes
LP_MONITOR_INTERVAL_SEC=60

# SCANNER_PERSIST_POOL_CACHE=false   # Strongly recommended to keep false (avoids heavy Supabase I/O)


# ─────────────────────────────────────────────────────────────────────────────
# SLIPPAGE & EXECUTION
# ─────────────────────────────────────────────────────────────────────────────
SWAP_SLIPPAGE_BPS=200              # Starting point for Jupiter ladders (open + close)


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL / ADVANCED
# ─────────────────────────────────────────────────────────────────────────────
# SOL_PRICE_USD=150                # Only set to override live Jupiter price

# If you want to be more aggressive on freshness
# FRESH_MAX_AGE_MINUTES=60         # Hard cap for evil-panda LP (90min max recommended)
