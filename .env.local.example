# =============================================================================
# METEORACLE — .env.local
# Only variables that MUST be set explicitly are listed here.
# Everything else has a safe default in the source code.
# =============================================================================

# --- Supabase (REQUIRED) -----------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# --- Solana RPC (REQUIRED) ---------------------------------------------------
HELIUS_API_KEY=YOUR_KEY

# --- Wallet (REQUIRED) -------------------------------------------------------
# Base58 private key. NEVER commit the real value.
WALLET_PRIVATE_KEY=
WALLET_PUBLIC_KEY=

# --- Telegram (REQUIRED) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=

# --- Bot kill-switches -------------------------------------------------------
# Set BOT_DRY_RUN=false only when ready to trade real funds.
BOT_ENABLED=false
BOT_DRY_RUN=true

# --- Position sizing & risk --------------------------------------------------
MAX_CONCURRENT_MARKET_LP_POSITIONS=3
MAX_MARKET_LP_SOL_PER_POSITION=0.1
MAX_MARKET_LP_SOL_DEPLOYED=0.99
WALLET_MIN_SOL_RESERVE=0.5
MAX_DAILY_LOSS_SOL=0

# DAMM migration positions (DBC graduation watcher)
DAMM_MIGRATION_SOL_PER_POSITION=0.1
MAX_DAMM_MIGRATION_SOL_DEPLOYED=0.1
MAX_CONCURRENT_DAMM_MIGRATION=2

# --- Strategy on/off switches ------------------------------------------------
EVIL_PANDA_ENABLED=true
SCALP_SPIKE_ENABLED=true
DAMM_EDGE_ENABLED=false

# --- DBC graduation watcher --------------------------------------------------
# Set to true to actually open positions after a pool graduates to DAMM v2.
DBC_OPEN_MIGRATED_POSITION_ENABLED=true
# Set to true if you want the bot to trigger the DAMM v2 migration itself.
DBC_AUTO_TRIGGER_MIGRATION=false
# Keep poll pool count low — the websocket subscription catches most pools anyway.
DBC_DISCOVERY_MAX_POOLS=100
# Terminal watchlist rows (rejected/failed/skipped) are deleted after this many hours.
WATCHLIST_STALE_TERMINAL_TTL_HOURS=6
