# =============================================================================
# METEORACLE — .env.local.example
#
# Copy this file to .env.local and fill in your values.
# Only override what you need — everything has sensible defaults in code.
#
# ORGANIZATION:
#   1. Required (must be set)
#   2. Safety Switches (strongly recommended)
#   3. Everything Else (strongly prefer using the website /config page)
#
# The goal is to keep this file as small as possible.
# Use the dashboard Config page for most tweaks instead of editing .env.local.
#
# NOTE: DAMM v2 / DAMM Edge support has been fully removed from the bot.
#       Only DLMM strategies (evil-panda, scalp-spike, etc.) are active.
# =============================================================================

# =============================================================================
# 1. REQUIRED — Core Infrastructure
# =============================================================================
SUPABASE_URL=https://rrkuvudpubjupnhwsccu.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://rrkuvudpubjupnhwsccu.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

HELIUS_API_KEY=
#HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
HELIUS_ENABLED=true
HELIUS_RATE_LIMIT_MIN_INTERVAL_MS=2000
HELIUS_RATE_LIMIT_BURST=1
HELIUS_MAX_ATTEMPTS=1
HELIUS_429_COOLDOWN_MS=30000
HELIUS_429_WRITE_MIN_INTERVAL_MS=10000
#HELIUS_HOLDER_MAX_PAGES=1
#RPC_URL=
#SOLANA_RPC_FALLBACK_URLS=
#ENABLE_HELIUS_RPC_URL_ALIAS=true
#ENABLE_RPC_URL_FALLBACKS=true

# Keep false/empty unless you explicitly do not want read-only public fallback RPC.
#DISABLE_PUBLIC_RPC_FALLBACK=true

# -----------------------------------------------------------------------------
# Wallet — REQUIRED (executor)
# Base58-encoded private key of the wallet the bot will trade from.
# NEVER commit this value. Keep it out of version control.
# -----------------------------------------------------------------------------
WALLET_PRIVATE_KEY=
# Optional public key for read-only dashboard/portfolio fetches.
# If omitted, the public key is derived from WALLET_PRIVATE_KEY.
WALLET_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Telegram — REQUIRED (alerts + command bot)
# Create a bot via @BotFather to get the token.
# Get your chat ID by messaging @userinfobot.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to issue commands. Defaults to TELEGRAM_CHAT_ID if empty.
TELEGRAM_ALLOWED_USERS=
# Only needed if using the Next.js Telegram webhook route. PM2 long-polling does not need it.
TELEGRAM_WEBHOOK_SECRET=


# =============================================================================
# 2. SAFETY SWITCHES (Strongly recommended to review)
# =============================================================================

# Master switch for the whole bot
BOT_ENABLED=false

# Extremely important safety net — keeps the bot from opening real positions
BOT_DRY_RUN=true


# =============================================================================
# 3. EVERYTHING ELSE (Strongly prefer configuring via the website instead)
# =============================================================================

# The website Config page (under /config) is the preferred way to tweak
# strategy filters, scanner behavior, risk limits, etc.
#
# Only set values here in .env.local if you have a specific reason
# (e.g. initial bootstrap before the website is accessible, or secrets).

# Most variables have reasonable defaults in lib/strategy-config.ts
# and can be changed live via the dashboard without editing this file.

# Examples of things you *can* still override here if desired:
# MAX_MARKET_LP_SOL_PER_POSITION=0.1
# MAX_CONCURRENT_MARKET_LP_POSITIONS=5
# EVIL_PANDA_ENABLED=true
# SCALP_SPIKE_ENABLED=true
# LP_SCAN_INTERVAL_SEC=300
#
SCANNER_PERSIST_POOL_CACHE=false   # Controls whether the scanner writes the full Meteora pool list
#                                    # to the scanner_pool_cache table on every refresh. This is OFF by
#                                    # default because it is very heavy on Supabase Disk I/O (large JSONB
#                                    # upserts + GIN index maintenance). Only turn on temporarily if you
#                                    # need cross-restart warm cache.
# SCANNER_POOL_CACHE_RETENTION_HOURS=48
#
# etc.

# Avoid putting dozens of variables here — it becomes hard to review.
# Use the website config UI when possible.
