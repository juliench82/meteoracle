# =============================================================================
# METEORACLE — .env.local.example (minimized)
# =============================================================================
# Copy this file to .env.local and fill in your values.
#
# Every variable below has NO code default or is a critical safety switch the
# operator must set consciously. All other tunables (strategy params, exit
# thresholds, scanner/monitor timing, RPC-rate-limit internals, etc.) have
# working defaults in lib/strategy-config.ts, lib/solana.ts, lib/rpc-rate-limit.ts
# and bot/rugcheck-cache.ts — see audit.md §7 for the full catalog.
#
# Current model: direct Meteora DLMM swaps only (no Jupiter). No Moonboy.
# No legacy strategies. No vestigial snapshot exits.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the bot will not start without these
# ─────────────────────────────────────────────────────────────────────────────
# Strongly recommended: Helius RPC + holder data
HELIUS_API_KEY=

# Executor wallet (base58 or JSON uint8 array). NEVER commit this value.
WALLET_PRIVATE_KEY=

# Optional public key for read-only (falls back to the wallet above)
# WALLET_PUBLIC_KEY=

# Telegram alerts + command bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated Telegram user IDs allowed to issue commands (optional;
# falls back to TELEGRAM_CHAT_ID if unset)
# TELEGRAM_ALLOWED_USERS=

# ─────────────────────────────────────────────────────────────────────────────
# SAFETY — consciously set before going live
# ─────────────────────────────────────────────────────────────────────────────
BOT_ENABLED=false
BOT_DRY_RUN=true

# ─────────────────────────────────────────────────────────────────────────────
# RPC (recommended for production — see lib/solana.ts)
# ─────────────────────────────────────────────────────────────────────────────
# RPC_URL=
# SOLANA_RPC_FALLBACK_URLS=
