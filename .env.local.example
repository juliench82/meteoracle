# =============================================================================
# METEORACLE — .env.local
#
# Copy this file to .env.local and fill in your secrets.
# Most tuning parameters have sensible defaults in the code.
# Only variables you are likely to change are documented here.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Core Infrastructure
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

HELIUS_API_KEY=YOUR_HELIUS_KEY
WALLET_PRIVATE_KEY=your_base58_private_key_here
WALLET_PUBLIC_KEY=YourPublicKeyHere

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=   # comma-separated user IDs

# -----------------------------------------------------------------------------
# Bot Kill Switches & Safety
# -----------------------------------------------------------------------------
BOT_ENABLED=false
BOT_DRY_RUN=true                 # Set to false only when ready for real trading

# -----------------------------------------------------------------------------
# Position Sizing & Global Risk Limits
# -----------------------------------------------------------------------------
MAX_CONCURRENT_MARKET_LP_POSITIONS=5
MAX_MARKET_LP_SOL_PER_POSITION=0.1
MAX_MARKET_LP_SOL_DEPLOYED=1.0
WALLET_MIN_SOL_RESERVE=0.5
MAX_DAILY_LOSS_SOL=0

# -----------------------------------------------------------------------------
# Scanner Tuning (Fresh vs Momentum lanes)
# -----------------------------------------------------------------------------
DEEP_CHECK_DELAY_MS=800
MAX_DEEP_CHECKS=6
FRESH_SCANNER_MAX_AGE_MINUTES=90
FRESH_MIN_LIQUIDITY_USD=20000
MOMENTUM_MIN_VOLUME_5M_USD=5000
MOMENTUM_MIN_FEE_TVL_5M_PCT=0.1
SCANNER_EARLY_MAX_AGE_MINUTES=90
HARD_MAX_TOKEN_AGE_MINUTES=120
CANDIDATE_DEDUP_HOURS=0

# Volume spike detection for Scalp Spike lane
SCALP_SPIKE_VOL_RATIO=2.5
SCALP_SPIKE_MIN_FEE_TVL_1H_PCT=1
SCALP_SPIKE_MIN_FEE_TVL_5M_PCT=0.1

# -----------------------------------------------------------------------------
# Evil Panda Strategy (main meme shitcoin DLMM strategy)
# Default values relaxed in May 2026 Option A review
# -----------------------------------------------------------------------------
EVIL_PANDA_ENABLED=true
EVIL_PANDA_MAX_AGE_HOURS=3                    # was 2 — now allows slightly more mature tokens
EVIL_PANDA_MIN_RUGCHECK_SCORE=250             # was 300 — increased hit rate on decent tokens
EVIL_PANDA_MIN_LIQUIDITY_USD=5000
EVIL_PANDA_MIN_HOLDER_COUNT=100
EVIL_PANDA_MIN_HOLDER_COUNT_UNDER_60M=50      # special lower gate for very fresh tokens
EVIL_PANDA_MAX_TOP_HOLDER_PCT=30
EVIL_PANDA_MIN_BIN_STEP=80

# Position & range
EVIL_PANDA_BIN_STEP=100
EVIL_PANDA_RANGE_DOWN_PCT=-50
EVIL_PANDA_RANGE_UP_PCT=100
EVIL_PANDA_SOL_BIAS=1

# Exits
EVIL_PANDA_STOP_LOSS_PCT=-25
EVIL_PANDA_TAKE_PROFIT_PCT=50
EVIL_PANDA_OOR_MINUTES=30
EVIL_PANDA_MAX_DURATION_HOURS=12
EVIL_PANDA_MIN_FEES_TO_CLAIM=0.001
EVIL_PANDA_MAX_IL_PCT=-15

# -----------------------------------------------------------------------------
# Scalp Spike Strategy (high-conviction volume surges)
# -----------------------------------------------------------------------------
SCALP_SPIKE_ENABLED=true
SCALP_SPIKE_MIN_MC_USD=500000
SCALP_SPIKE_MIN_LIQUIDITY_USD=10000
SCALP_SPIKE_MIN_HOLDER_COUNT=200
SCALP_SPIKE_MAX_TOP_HOLDER_PCT=25
SCALP_SPIKE_MIN_RUGCHECK_SCORE=400
SCALP_SPIKE_BIN_STEP=100
SCALP_SPIKE_RANGE_DOWN_PCT=-20
SCALP_SPIKE_RANGE_UP_PCT=40
SCALP_SPIKE_STOP_LOSS_PCT=-15
SCALP_SPIKE_TAKE_PROFIT_PCT=30
SCALP_SPIKE_OOR_MINUTES=15
SCALP_SPIKE_MAX_DURATION_HOURS=6

# -----------------------------------------------------------------------------
# DAMM Edge Strategy (very fresh DAMM v2 pre-grad tokens)
# Loosened in May 2026 Option A review — now env configurable
# -----------------------------------------------------------------------------
DAMM_EDGE_ENABLED=false
DAMM_EDGE_MAX_AGE_MINUTES=25                  # was 15 — significantly more candidates
DAMM_EDGE_MIN_FEE_TVL_PCT=5                   # was 8% — realistic early demand threshold
DAMM_EDGE_MIN_LIQUIDITY_USD=25000
DAMM_EDGE_MAX_MC_USD=5000000
DAMM_EDGE_SOL_PER_POSITION=0.1

# DAMM migration / pre-grad track (separate from pure DAMM Edge)
MAX_CONCURRENT_DAMM_MIGRATION_POSITIONS=1
DAMM_MIGRATION_SOL_PER_POSITION=0.1
MAX_DAMM_MIGRATION_SOL_DEPLOYED=0.1

# -----------------------------------------------------------------------------
# Other Strategies
# -----------------------------------------------------------------------------
STABLE_FARM_ENABLED=true
STABLE_FARM_MIN_LIQUIDITY_USD=50000
STABLE_FARM_BIN_STEP=1
STABLE_FARM_RANGE_DOWN_PCT=-2
STABLE_FARM_RANGE_UP_PCT=2
STABLE_FARM_STOP_LOSS_PCT=-5
STABLE_FARM_TAKE_PROFIT_PCT=10
STABLE_FARM_OOR_MINUTES=10
STABLE_FARM_MAX_DURATION_HOURS=168
STABLE_FARM_MIN_FEES_TO_CLAIM=0.0001
STABLE_FARM_MAX_IL_PCT=-3

BLUECHIP_FARM_ENABLED=false
BLUECHIP_FARM_MIN_MC_USD=100000000
BLUECHIP_FARM_MIN_VOLUME_24H=500000
BLUECHIP_FARM_MIN_LIQUIDITY_USD=100000
BLUECHIP_FARM_MIN_HOLDER_COUNT=5000
BLUECHIP_FARM_MAX_TOP_HOLDER_PCT=25

MOONBOY_ENABLED=true

# -----------------------------------------------------------------------------
# Monitor & Live Data
# -----------------------------------------------------------------------------
LP_MONITOR_INTERVAL_SEC=60
LP_MONITOR_ENABLED=true
MONITOR_EXITS_ENABLED=true
MONITOR_SYNC_FAIL_ALERT_THRESHOLD=3
ORPHAN_CHECK_EVERY_N=1
MONITOR_LIVE_CACHE_ALERT_INTERVAL_MIN=15

# Live Meteora snapshot is now the source of truth for open positions + PnL
# (dashboard + monitor prefer live data over Supabase for financial fields)

# -----------------------------------------------------------------------------
# Swap & Transaction Settings
# -----------------------------------------------------------------------------
SWAP_SLIPPAGE_BPS=100

# Priority fees (optional but recommended on mainnet)
# PRIORITY_FEE_MICROLAMPORTS=100000
# COMPUTE_UNIT_LIMIT=400000

# -----------------------------------------------------------------------------
# Misc / Debugging
# -----------------------------------------------------------------------------
# Set to true to force all scanner activity into tickMode (no new opens)
LP_SCANNER_ENABLED=true
