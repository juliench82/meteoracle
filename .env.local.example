# =============================================================================
# METEORACLE — .env.local.example
#
# Copy this file to .env.local and fill in your values.
#
# Current model: real /pools API fields + derivations only (see top block for tunables).
# Legacy FRESH_* and old 15m "very fresh" vars are no longer used.
#
# No Moonboy. No legacy strategies.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. REQUIRED — Core Infrastructure
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_URL=                  # Used for alerts + bot_logs (lightweight, optional in current model)
# SUPABASE_SECRET_KEY=

HELIUS_API_KEY=                # Strongly recommended for accurate holder data

# -----------------------------------------------------------------------------
# Wallet — REQUIRED (executor)
# Base58-encoded private key of the wallet the bot will trade from.
# NEVER commit this value. Keep it out of version control.
# -----------------------------------------------------------------------------
WALLET_PRIVATE_KEY=

# Optional public key for read-only dashboard/portfolio fetches.
# If omitted, the public key is derived from WALLET_PRIVATE_KEY.
# WALLET_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Telegram — REQUIRED (alerts + command bot)
# Create a bot via @BotFather to get the token.
# Get your chat ID by messaging @userinfobot.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to issue commands. Defaults to TELEGRAM_CHAT_ID if empty.
# TELEGRAM_ALLOWED_USERS=


# ─────────────────────────────────────────────────────────────────────────────
# SAFETY (very important)
# ─────────────────────────────────────────────────────────────────────────────
BOT_ENABLED=false
BOT_DRY_RUN=true


# ─────────────────────────────────────────────────────────────────────────────
# 2. Core Risk & Sizing (very important to review)
# ─────────────────────────────────────────────────────────────────────────────
MAX_CONCURRENT_MARKET_LP_POSITIONS=3
MAX_MARKET_LP_SOL_PER_POSITION=0.22
MAX_MARKET_LP_SOL_DEPLOYED=0.66
WALLET_MIN_SOL_RESERVE=0.8    # Raised for safety (small wallet ~$100 SOL)

# Optional daily loss circuit breaker
# MAX_DAILY_LOSS_SOL=0.3


# ─────────────────────────────────────────────────────────────────────────────
# EVIL PANDA LP STRATEGY (main LP logic)
# ─────────────────────────────────────────────────────────────────────────────
# Freshness & quality gates
# EVIL_PANDA_MAX_AGE_HOURS=1.5         # Recommended for aggressive fresh hunting
# EVIL_PANDA_MIN_RUGCHECK_SCORE=40
# EVIL_PANDA_MIN_LIQUIDITY_USD=8000
# EVIL_PANDA_MAX_TOP_HOLDER_PCT=30

# Bin range (wide for stability on volatile names)
# EVIL_PANDA_RANGE_DOWN_PCT=-50
# EVIL_PANDA_RANGE_UP_PCT=100
# EVIL_PANDA_BIN_STEP=100

# Legacy snapshot fields only (real LP exits are the LP_* section below)
# EVIL_PANDA_OOR_MINUTES=30
# EVIL_PANDA_MAX_DURATION_HOURS=1
# EVIL_PANDA_MIN_FEES_TO_CLAIM=0.001


# ─────────────────────────────────────────────────────────────────────────────
# SCANNER & MONITOR TIMING
# ─────────────────────────────────────────────────────────────────────────────
LP_SCAN_INTERVAL_SEC=900           # 15 minutes (code default). Use 300 for more aggressive scanning
LP_MONITOR_INTERVAL_SEC=60

# Current model (Claude latest recs — real /pools fields only + derivations)
# MIN_TVL_USD=500
# MIN_FEE_24H=5
# MIN_FEE_TVL_RATIO_24H=0.005
# MIN_IMPLIED_ACTIVE_TVL=330
# MAX_IMPLIED_ACTIVE_TVL=750000
# MIN_LP_COUNT=3
# MIN_POOL_AGE_HOURS=2
# ACTIVITY_MAX_POOL_AGE_MINUTES=4320

# Old FRESH_* / 15m vars are legacy (ignored).

# SCANNER_PERSIST_POOL_CACHE is no longer used (fully removed)


# ─────────────────────────────────────────────────────────────────────────────
# LP EXIT RULES (ultra-minimal 4-rule model)
# 1h hard max duration for fresh positions + Fee/TVL, OOR, net PnL rules.
# ─────────────────────────────────────────────────────────────────────────────
# LP_FEE_TVL_EXIT_THRESHOLD=0.75     # last-4h avg of pool 24h Fee/TVL % below this → close
# LP_OOR_EXIT_MINUTES=45             # minutes continuously out of range before exit
# LP_NET_LOSS_SL_PCT=-30             # net PnL (price move + claimed + unclaimed fees) stop loss
# LP_NET_LOSS_SL_MIN_AGE_MIN=20      # grace period (minutes) before net-PnL SL can trigger
# LP_MAX_DURATION_HOURS=1            # hard safety cap (1h for fresh volatile memes)
# LP_MONITOR_ENABLED=true



# ─────────────────────────────────────────────────────────────────────────────
# SLIPPAGE & EXECUTION
# ─────────────────────────────────────────────────────────────────────────────
SWAP_SLIPPAGE_BPS=200              # Starting point for Jupiter ladders (open + close)


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL / ADVANCED
# ─────────────────────────────────────────────────────────────────────────────
# SOL_PRICE_USD=150                # Only set to override live Jupiter price

# See the main "Current activity model" section above for the relevant scanner tunables.
# METEORA_POOL_FETCH_LIMIT=1200
# MAX_FRESH_DEEP_CHECKS=12         # cap on how many top candidates we deep-check
