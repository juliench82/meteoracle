# =============================================================================
# METEORACLE — .env.local.example
#
# Copy this file to .env.local and fill in your values.
#
# Current model:
# - Real /pools API fields + derivations only
# - Ghost position prevention (early secret persist before any rent)
# - Post-swap add pre-sim on *actual* amounts + wide-range CU fixes
# - Automatic recovery in monitor (init with secret + close)
#
# No Moonboy. No legacy strategies.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. REQUIRED — Core Infrastructure
# ─────────────────────────────────────────────────────────────────────────────
HELIUS_API_KEY=                # Strongly recommended (holders + better RPC)

# -----------------------------------------------------------------------------
# Wallet — REQUIRED (executor)
# Base58-encoded private key (or JSON array) of the wallet the bot will trade from.
# NEVER commit this value.
# -----------------------------------------------------------------------------
WALLET_PRIVATE_KEY=

# Optional public key for read-only.
# WALLET_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Telegram — REQUIRED (alerts + command bot)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to issue commands.
# TELEGRAM_ALLOWED_USERS=

# Path to pm2 binary (used by the Telegram control bot for /stop /reload etc.)
# PM2_BIN=/usr/local/bin/pm2


# ─────────────────────────────────────────────────────────────────────────────
# SAFETY (very important)
# ─────────────────────────────────────────────────────────────────────────────
BOT_ENABLED=false
BOT_DRY_RUN=true


# ─────────────────────────────────────────────────────────────────────────────
# RECOVERY (stranded sells / rent reclaim)
# ─────────────────────────────────────────────────────────────────────────────
# Minimum acceptable recovery % of original SOL when doing stranded token sells
# in lib/swap.ts (retryStrandedSells). Used together with USD floor logic.
# STRANDED_MIN_RECOVERY_PCT=50

# Close-in-progress marker staleness window, in minutes (default 15).
# closePosition persists a close_in_progress_at timestamp before the removeLiquidity tx
# and clears it (null) on both success and failure, so a PM2 restart cannot double-close
# a position. A marker older than this window is treated as stale (a crashed close) and
# the close is allowed to proceed, so a crash can never wedge a position forever.
# CLOSE_IN_PROGRESS_STALE_MIN=15


# ─────────────────────────────────────────────────────────────────────────────
# 2. Core Risk & Sizing
# ─────────────────────────────────────────────────────────────────────────────
MAX_CONCURRENT_MARKET_LP_POSITIONS=3
MAX_MARKET_LP_SOL_PER_POSITION=0.22   # (maps to MARKET_LP_SOL_PER_POSITION)
SWAP_BUY_SOL_AMOUNT=0.1                 # dedicated fixed SOL for standalone acquireTokensWithFixedSol (can differ from position SOL leg)
MAX_MARKET_LP_SOL_DEPLOYED=0.66
WALLET_MIN_SOL_RESERVE=0.8

# Optional
# MAX_DAILY_LOSS_SOL=0.3


# ─────────────────────────────────────────────────────────────────────────────
# EVIL PANDA LP STRATEGY
# ─────────────────────────────────────────────────────────────────────────────
# EVIL_PANDA_ENABLED=true

# Quality / filter gates
# EVIL_PANDA_MAX_AGE_HOURS=48
# EVIL_PANDA_MIN_RUGCHECK_SCORE=40
# Rugcheck API circuit breaker (G7) — fail-open + alert on sustained outage.
# RUGCHECK_CIRCUIT_FAILURE_THRESHOLD=3   # consecutive API failures before opening the breaker
# RUGCHECK_OUTAGE_SCORE=100                # score returned (accept w/ warning) while breaker is OPEN
# RUGCHECK_CIRCUIT_COOLDOWN_MS=300000      # (reserved) close-delay refinement; not wired (reset-on-success)
# EVIL_PANDA_MIN_LIQUIDITY_USD=500
# EVIL_PANDA_MIN_HOLDER_COUNT=50
# EVIL_PANDA_MAX_TOP_HOLDER_PCT=30

# Position shape (Bid-Ask)
# EVIL_PANDA_RANGE_DOWN_PCT=-50
# EVIL_PANDA_RANGE_UP_PCT=100
# EVIL_PANDA_BIN_STEP=100
# EVIL_PANDA_SOL_BIAS=1

# Legacy snapshot exits (real exits use the LP_* rules below)
# EVIL_PANDA_OOR_MINUTES=30
# EVIL_PANDA_MAX_DURATION_HOURS=1
# EVIL_PANDA_MIN_FEES_TO_CLAIM=0.001


# ─────────────────────────────────────────────────────────────────────────────
# SCANNER & MONITOR TIMING + TUNABLES
# ─────────────────────────────────────────────────────────────────────────────
LP_SCAN_INTERVAL_SEC=900
LP_MONITOR_INTERVAL_SEC=60

# Feature flags (checked in worker + monitor)
# LP_MONITOR_ENABLED=true
# LP_SCANNER_ENABLED=true
# SCANNER_ENABLED=true

# Standalone scanner mode (used when running the scanner process directly)
# LP_SCANNER_STANDALONE=false

# Timeout for a full scanner tick (prevents hanging on slow deep checks)
# LP_SCANNER_TICK_TIMEOUT_MS=570000
# SCANNER_TICK_TIMEOUT_MS=570000   # legacy fallback name also supported

# Activity / quality model (real /pools fields + derivations)
# MIN_TVL_USD=500
# MIN_FEE_24H=5
# MIN_FEE_TVL_RATIO_24H=0.005
# MIN_IMPLIED_ACTIVE_TVL=505       # implied active TVL = fees_1h*100/fee_tvl_ratio_1h (== pool's real tvl, true USD)
# MAX_IMPLIED_ACTIVE_TVL=1614888   # re-derived window (was 330/750000 under the old volume_1h/fee_pct proxy)
# MIN_LP_COUNT=3
# MIN_POOL_AGE_HOURS=2
# ACTIVITY_MAX_POOL_AGE_MINUTES=4320

# Misc scanner
# METEORA_POOL_FETCH_LIMIT=50
# MAX_FRESH_DEEP_CHECKS=12
# DEEP_CHECK_DELAY_MS=800
# CANDIDATE_DEDUP_HOURS=1
# OOR_RECHECK_HOURS=24
# HELIUS_ENABLED=false
# HELIUS_HOLDER_MAX_PAGES=5

# Cache TTL for /pools responses (in ms)
# METEORA_POOLS_CACHE_TTL_MS=300000

# LP exit rules (ultra-minimal model)
# LP_FEE_TVL_EXIT_THRESHOLD=5.54   # percent (API unit); p10 of the recorded scanner-selected
#                                  # 24h Fee/TVL distribution — see README + tests/fixtures
# LP_OOR_EXIT_MINUTES=45
# LP_NET_LOSS_SL_PCT=-30
# LP_NET_LOSS_SL_MIN_AGE_MIN=20
# LP_NET_LOSS_SL_INTERIM_PCT=-15   # tighter net-PnL SL active during warm-up grace (before MIN_AGE_MIN)
# LP_MAX_DURATION_HOURS=1
# LP_FEE_TVL_SAMPLE_WINDOW_H=4
# LP_MONITOR_ENABLED=true
# MAX_POOL_PRICE_DEVIATION=0.05
# LP_SCORE_LP_CAP=20

# Deep survivor scoring weights (post deep-check ranking in bot/scanner/pool-metrics.ts).
# Recent 1h fee/TVL velocity gets highest weight. Change only after observing real data.
# LP_SCORE_FEE_TVL_1H_WEIGHT=0.5
# LP_SCORE_FEE_TVL_24H_WEIGHT=0.3
# LP_SCORE_LP_COUNT_WEIGHT=0.2


# ─────────────────────────────────────────────────────────────────────────────
# SLIPPAGE & EXECUTION
# ─────────────────────────────────────────────────────────────────────────────
# SWAP_SLIPPAGE_BPS (legacy — current direct DLMM path uses internal ladders)


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL / ADVANCED
# ─────────────────────────────────────────────────────────────────────────────
# SOL_PRICE_USD=150                # Only set to override live SOL price

# RPC (highly recommended for production — see lib/solana.ts)
# RPC_URL=
# SOLANA_RPC_FALLBACK_URLS=
# ENABLE_RPC_URL_FALLBACKS=true
# ENABLE_PUBLIC_RPC_FALLBACK=false
# ENABLE_HELIUS_RPC_URL_ALIAS=false   # alternative way to provide Helius RPC

# Off-host state/ backup (G5). STATE_BACKUP_TARGET copies state/* into this dir;
# STATE_BACKUP_S3_PREFIX syncs via `aws s3 sync state/ <prefix>/` (no S3 SDK).
# With neither set, backupState is a dry-safe no-op. STATE_BACKUP_INTERVAL_SEC (default 900).
# STATE_BACKUP_TARGET=/mnt/backups/meteoracle
# STATE_BACKUP_S3_PREFIX=s3://my-bucket/meteoracle-state
# STATE_BACKUP_INTERVAL_SEC=900

# RPC fallback behavior is documented above.
