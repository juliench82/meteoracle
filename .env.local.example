# =============================================================================
# METEORACLE — .env.local.example
#
# Copy this file to .env.local and fill in your values.
# Only override what you need — everything has sensible defaults in code.
#
# ORGANIZATION:
#   1. Required (must be set)
#   2. Core Risk & Sizing
#   3. Scanner Tuning
#   4. Features (enable/disable strategies)
#   5. Strategy Settings (filters & behavior)
#   6. Monitor & Operations
#   7. Advanced / Rarely Needed
#
# Most people only need sections 1–3 + a few overrides in 5.
# =============================================================================


# =============================================================================
# 1. REQUIRED — Core Infrastructure
# =============================================================================

SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

HELIUS_API_KEY=

WALLET_PRIVATE_KEY=
WALLET_PUBLIC_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=


# =============================================================================
# 2. CORE RISK & SIZING (Review these carefully)
# =============================================================================

# --- Bot Safety ---
BOT_ENABLED=false
BOT_DRY_RUN=true                    # Set to false only when ready for real money

# --- Position Sizing & Exposure ---
MAX_CONCURRENT_MARKET_LP_POSITIONS=5
MAX_MARKET_LP_SOL_PER_POSITION=0.1
MAX_MARKET_LP_SOL_DEPLOYED=1.0
WALLET_MIN_SOL_RESERVE=0.5
MAX_DAILY_LOSS_SOL=0


# =============================================================================
# 3. SCANNER TUNING
# =============================================================================

# Main scan interval (seconds). 300–420 (5–7 min) is a good balance for free tiers.
LP_SCAN_INTERVAL_SEC=300

# How many tokens to deeply inspect per scan (Helius + Rugcheck).
# Keep this low on free tiers.
MAX_DEEP_CHECKS=6
DEEP_CHECK_DELAY_MS=1500

# Fresh lane filter
FRESH_SCANNER_MAX_AGE_MINUTES=90
FRESH_MIN_LIQUIDITY_USD=20000

# Deduplication window (hours). Set to 0 only when actively tuning.
CANDIDATE_DEDUP_HOURS=1


# =============================================================================
# 4. FEATURES (Enable/disable entire strategies & components)
# =============================================================================

EVIL_PANDA_ENABLED=true
SCALP_SPIKE_ENABLED=true
DAMM_EDGE_ENABLED=false
STABLE_FARM_ENABLED=true
BLUECHIP_FARM_ENABLED=false
MOONBOY_ENABLED=true

LP_SCANNER_ENABLED=true
HELIUS_ENABLED=true


# =============================================================================
# 5. STRATEGY SETTINGS (Only override what you need)
# =============================================================================

# --- Evil Panda ---
EVIL_PANDA_MAX_AGE_HOURS=3
EVIL_PANDA_MIN_RUGCHECK_SCORE=50
EVIL_PANDA_MIN_HOLDER_COUNT=50
EVIL_PANDA_MIN_LIQUIDITY_USD=5000
EVIL_PANDA_MIN_BIN_STEP=80

# --- Scalp Spike ---
SCALP_SPIKE_MIN_MC_USD=500000
SCALP_SPIKE_MIN_RUGCHECK_SCORE=60
SCALP_SPIKE_MIN_HOLDER_COUNT=150
SCALP_SPIKE_MIN_LIQUIDITY_USD=10000

# --- DAMM Edge (pre-grad) ---
DAMM_EDGE_MAX_AGE_MINUTES=25
DAMM_EDGE_MIN_FEE_TVL_PCT=5
DAMM_EDGE_MIN_LIQUIDITY_USD=25000

# --- Stable Farm (optional) ---
STABLE_FARM_MIN_LIQUIDITY_USD=50000

# Most other strategy parameters have good defaults.
# Only add more lines here if you have a specific reason to change them.


# =============================================================================
# 6. MONITOR & OPERATIONS
# =============================================================================

LP_MONITOR_INTERVAL_SEC=60
LP_MONITOR_ENABLED=true
MONITOR_EXITS_ENABLED=true


# =============================================================================
# 7. ADVANCED / RARELY NEEDED
# =============================================================================

SWAP_SLIPPAGE_BPS=100

# Priority fee & compute (mainnet)
# PRIORITY_FEE_MICROLAMPORTS=100000
# COMPUTE_UNIT_LIMIT=400000

# HELIUS_HOLDER_MAX_PAGES=1   # Increase only if you have a paid Helius plan
# MIN_SCORE_TO_OPEN=65
